# MR. CHICKEN HOUSE POS - optional cloud and server configuration.
# Non-secret build flag; set true only after cloud server variables are ready.
VITE_ENABLE_CLOUD=false
# The browser/device workspace works without any of these Firebase values.
# Copy this file to .env only when running a local hub or testing cloud setup.
HOST=0.0.0.0
PORT=3001
DATABASE_PATH=data/retail-pos.sqlite
POS_DEMO_MODE=true
# For a new empty hub: set POS_DEMO_MODE=false and choose 6-12 private digits.
INITIAL_ADMIN_PIN=
COOKIE_SECURE=false
ALLOWED_ORIGINS=

# Firebase setup. Configure real values on the server.
# Add these as SERVER environment variables in a separate hosting project.
# Never prefix credentials with VITE_. Never commit a service-account file.
FIREBASE_DATABASE_URL=
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=
CLOUD_POS_PIN_HASH=
COCONUT_POS_PIN_HASH=
CLOUD_IMPORT_CHICKEN_LEGACY=false
CLOUD_POS_PIN=
CLOUD_SESSION_SECRET=
# Optional owner-only logo unlock, separate from the staff sign-in PIN.
CLOUD_ADMIN_PIN=
CLOUD_ADMIN_PIN_HASH=

# Optional branch-hub receiver deployment, separate from the browser workspace.
HUB_ID=retail-main-hub
HUB_BRANCH_ID=b1
SYNC_ENDPOINT=
SYNC_TOKEN=
CLOUD_HOST=0.0.0.0
CLOUD_PORT=3002
CLOUD_TENANT_ID=chicken-shop
CLOUD_HUB_CREDENTIALS=

# Optional legacy compatibility; not needed for normal shared-shop PIN entry.
CLOUD_OWNER_EMAIL=
CLOUD_OWNER_PASSWORD_HASH=
CLOUD_OWNER_PASSWORD=
